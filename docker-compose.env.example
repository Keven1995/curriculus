# Copy to .env.postgres (ignored by Git) and set a unique local password.
# A random hexadecimal password can be generated with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_DB=curriculus_local
POSTGRES_USER=curriculus_local
POSTGRES_PASSWORD=

# Host-side URLs. Use the same local-only connection for migrations and integration tests.
# The hexadecimal password above is URL-safe and does not need escaping.
DATABASE_URL=
TEST_DATABASE_URL=

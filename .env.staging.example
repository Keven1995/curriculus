# Template only: use a separate staging project, database, storage and secret store.
# Never copy production credentials or personal data into this environment.
NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://staging.example.invalid
NEXT_PUBLIC_API_URL=https://api-staging.example.invalid
# Replace with the verified number of trusted proxy hops for the staging ingress (0..5).
TRUST_PROXY_HOPS=0
DATABASE_URL=postgres://staging-user:REPLACE@staging-db.example.invalid:5432/curriculus_staging
RATE_LIMIT_HMAC_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
DOCUMENT_STORAGE_DIR=/mnt/curriculus-staging-private
DOCUMENT_DOWNLOAD_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
METRICS_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES

# Keep paid/external processing disabled until the specific staging test is approved.
AI_ANALYSIS_ENABLED=false
OPENAI_ANALYSIS_ENABLED=false
OPENAI_API_KEY=
MERCADOPAGO_PIX_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
